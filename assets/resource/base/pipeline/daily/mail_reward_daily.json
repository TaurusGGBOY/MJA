{
  "邮件奖励-任务入口": {
    "recognition": "DirectHit",
    "action": "Custom",
    "custom_action": "BeginTask",
    "custom_action_param": {
      "task_id": "MAIL_REWARD_DAILY"
    },
    "max_hit": 1,
    "next": [
      "[JumpBack]公共-已知-点击空白关闭",
      "邮件奖励-邮件-页面",
      "邮件奖励-打开-邮件",
      "邮件奖励-主页-探测"
    ],
    "on_error": ["邮件奖励-记录-失败"]
  },
  "邮件奖励-领取": {
    "recognition": {
      "type": "And",
      "param": {
        "all_of": ["邮件奖励-邮件-页面", "邮件奖励-邮件-领取-全部"],
        "box_index": 1
      }
    },
    "action": "Custom",
    "max_hit": 1,
    "custom_action": "GuardedInput",
    "custom_action_param": {
      "task_id": "MAIL_REWARD_DAILY",
      "action_id": "claim_all_mail",
      "kind": "click",
      "evidence": {
        "page_index": 0,
        "target_index": 1,
        "page_name": "邮件奖励-邮件-页面",
        "target_name": "邮件奖励-邮件-领取-全部"
      }
    },
    "next": ["邮件奖励-奖励-探测"],
    "on_error": ["邮件奖励-空-探测"]
  },
  "邮件奖励-空-探测": {
    "recognition": {
      "type": "And",
      "param": {
        "all_of": ["邮件奖励-邮件-页面", "邮件奖励-邮件-空"],
        "box_index": 1
      }
    },
    "timeout": 8000,
    "action": "DoNothing",
    "next": ["邮件奖励-已完成"],
    "on_error": ["邮件奖励-记录-失败"]
  },
  "邮件奖励-已完成": {
    "recognition": "DirectHit",
    "action": "Custom",
    "custom_action": "RecordTaskOutcome",
    "custom_action_param": {
      "task_id": "MAIL_REWARD_DAILY",
      "status": "already_complete",
      "postcondition": "mail.empty",
      "defer_home_boundary": true
    },
    "next": ["邮件奖励-关闭"],
    "on_error": ["邮件奖励-记录-失败"]
  },
  "邮件奖励-奖励-探测": {
    "recognition": "OCR",
    "expected": ["恭喜获得", "点击空白处关闭"],
    "roi": [0, 120, 1280, 600],
    "timeout": 8000,
    "action": "DoNothing",
    "next": ["邮件奖励-领取-成功"],
    "on_error": ["邮件奖励-记录-失败"]
  },
  "邮件奖励-关闭-奖励": {
    "recognition": {
      "type": "And",
      "param": {
        "all_of": ["邮件奖励-邮件-奖励-弹窗", "邮件奖励-邮件-奖励-弹窗-关闭"],
        "box_index": 1
      }
    },
    "action": "Custom",
    "max_hit": 1,
    "custom_action": "GuardedInput",
    "custom_action_param": {
      "task_id": "MAIL_REWARD_DAILY",
      "action_id": "close_reward_popup",
      "kind": "click",
      "evidence": {
        "page_index": 0,
        "target_index": 1,
        "page_name": "邮件奖励-邮件-奖励-弹窗",
        "target_name": "邮件奖励-邮件-奖励-弹窗-关闭"
      }
    },
    "next": ["邮件奖励-关闭"],
    "on_error": ["邮件奖励-记录-失败"]
  },
  "邮件奖励-领取-成功": {
    "recognition": "DirectHit",
    "action": "Custom",
    "custom_action": "RecordTaskOutcome",
    "custom_action_param": {
      "task_id": "MAIL_REWARD_DAILY",
      "status": "success",
      "postcondition": "mail.reward_claimed",
      "defer_home_boundary": true
    },
    "next": ["邮件奖励-关闭-奖励"]
  },
  "邮件奖励-记录-失败": {
    "recognition": "DirectHit",
    "action": "Custom",
    "custom_action": "RecordTaskOutcome",
    "custom_action_param": {
      "task_id": "MAIL_REWARD_DAILY",
      "status": "failed",
      "postcondition": "MAIL_POSTCONDITION_MISSING",
      "error_code": "MAIL_POSTCONDITION_MISSING",
      "native_fail_after_record": true
    },
    "Abort": true,
    "next": ["公共-通用中止"]
  },
