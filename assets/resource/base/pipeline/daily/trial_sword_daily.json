    "custom_action": "RecordTaskOutcome",
    "custom_action_param": {
      "task_id": "TRIAL_SWORD_DAILY",
      "status": "failed",
      "postcondition": "TRIAL_POSTCONDITION_MISSING",
      "error_code": "TRIAL_POSTCONDITION_MISSING",
      "native_fail_after_record": true
    },
    "Abort": true,
    "next": ["MJA_COMMON_ABORT"]
  },
