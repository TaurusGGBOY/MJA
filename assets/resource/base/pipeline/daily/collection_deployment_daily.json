        "box_index": 1
      }
    },
    "action": "DoNothing",
    "next": ["MJA_COLLECTION_HARVEST_SUCCESS"],
    "on_error": ["MJA_COLLECTION_RECORD_FAILURE"]
  },
  "MJA_COLLECTION_PAGE_PROBE": {
