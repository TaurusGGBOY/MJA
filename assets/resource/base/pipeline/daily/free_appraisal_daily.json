{
  "MJA_FREE_APPRAISAL_DAILY_START": {
    "recognition": "DirectHit",
    "action": "Custom",
    "custom_action": "BeginTask",
    "custom_action_param": {"task_id": "FREE_APPRAISAL_DAILY"},
    "timeout": 8000,
    "next": [
      "[JumpBack]MJA_KNOWN_PAINTING_CLOSE",
      "[JumpBack]MJA_APPRAISAL_EXTRA_POPUP_CLOSE",
      "[JumpBack]MJA_APPRAISAL_KNOWN_TEA_SHOP_CLOSE",
      "MJA_APPRAISAL_REWARD_PROBE",
      "MJA_APPRAISAL_PAGE_PROBE",
      "MJA_APPRAISAL_HOME_PROBE",
      "MJA_APPRAISAL_CLOSE_RECOVERED_PANEL"
    ],
    "on_error": [
      "MJA_APPRAISAL_RUNTIME_RECOVERY_ATTEMPT",
      "MJA_APPRAISAL_RECORD_FAILURE"
    ],
    "retry_times": 0
  },
  "MJA_APPRAISAL_RUNTIME_RECOVERY_ATTEMPT": {
    "max_hit": 1,
    "recognition": "DirectHit",
    "timeout": 30000,
    "action": "DoNothing",
    "next": [
      "MJA_APPRAISAL_REWARD_PROBE",
      "MJA_APPRAISAL_PAGE_PROBE",
      "MJA_APPRAISAL_HOME_PROBE",
      "MJA_APPRAISAL_CLOSE_RECOVERED_PANEL",
      "[JumpBack]MJA_GAME_START"
    ],
    "on_error": ["MJA_APPRAISAL_RECORD_FAILURE"],
    "retry_times": 0
  },
  "MJA_APPRAISAL_KNOWN_TEA_SHOP_CLOSE": {
    "max_hit": 1,
    "recognition": {
      "type": "And",
      "param": {
        "all_of": [
          "appraisal.universal_shop.page",
          "appraisal.universal_shop.close"
        ],
        "box_index": 1
      }
    },
    "timeout": 5000,
    "action": "Click",
    "on_error": ["MJA_APPRAISAL_RECORD_FAILURE"],
    "retry_times": 0
  },
  "MJA_APPRAISAL_PAGE_PROBE": {
    "recognition": "OCR",
    "expected": "鉴宝",
    "roi": [0, 0, 500, 220],
    "timeout": 8000,
    "action": "DoNothing",
    "next": ["MJA_APPRAISAL_CLAIM"],
    "on_error": ["MJA_APPRAISAL_RECORD_FAILURE"]
  },
  "MJA_APPRAISAL_CLAIM": {
    "max_hit": 1,
    "recognition": {"type": "And", "param": {
      "all_of": ["appraisal.page", "appraisal.free_once"], "box_index": 1
    }},
    "action": "Custom",
    "custom_action": "GuardedInput",
    "custom_action_param": {
      "task_id": "FREE_APPRAISAL_DAILY",
      "action_id": "claim_free_appraisal_once",
      "kind": "click",
      "evidence": {
        "page_index": 0, "target_index": 1,
        "page_name": "appraisal.page", "target_name": "appraisal.free_once"
      }
    },
    "next": ["MJA_APPRAISAL_REWARD_PROBE"],
    "on_error": ["MJA_APPRAISAL_RECORD_FAILURE"],
    "timeout": 8000,
    "retry_times": 0
  },
  "MJA_APPRAISAL_REWARD_PROBE": {
    "recognition": {"type": "And", "param": {
      "all_of": ["appraisal.result_popup", "appraisal.popup_close"],
      "box_index": 0
    }},
    "timeout": 8000,
    "action": "DoNothing",
    "next": ["MJA_APPRAISAL_REWARD_SUCCESS"],
    "on_error": ["MJA_APPRAISAL_RECORD_FAILURE"]
  },
  "MJA_APPRAISAL_REWARD_SUCCESS": {
    "recognition": "DirectHit",
    "action": "Custom",
    "custom_action": "RecordTaskOutcome",
    "custom_action_param": {
      "task_id": "FREE_APPRAISAL_DAILY",
      "status": "success",
      "postcondition": "appraisal.reward_popup_seen",
      "defer_home_boundary": true
    },
    "next": ["MJA_APPRAISAL_CLOSE_REWARD"],
    "on_error": ["MJA_APPRAISAL_RECORD_FAILURE"]
  },
  "MJA_APPRAISAL_CLOSE_REWARD": {
    "max_hit": 1,
    "recognition": {"type": "And", "param": {
      "all_of": ["appraisal.result_popup", "appraisal.popup_close"], "box_index": 1
    }},
    "action": "Custom",
    "custom_action": "GuardedInput",
    "custom_action_param": {
      "task_id": "FREE_APPRAISAL_DAILY",
      "action_id": "close_appraisal_popup",
      "kind": "click",
      "evidence": {
        "page_index": 0, "target_index": 1,
        "page_name": "appraisal.result_popup", "target_name": "appraisal.popup_close"
      }
    },
    "next": [
      "[JumpBack]MJA_APPRAISAL_EXTRA_POPUP_CLOSE",
      "MJA_APPRAISAL_CLOSE_SUCCESS_PAGE",
      "MJA_APPRAISAL_HOME_AFTER_REWARD"
    ],
    "on_error": ["MJA_APPRAISAL_RECORD_FAILURE"],
    "timeout": 8000,
    "retry_times": 0
  },
  "MJA_APPRAISAL_CLOSE_SUCCESS_PAGE": {
    "max_hit": 1,
    "recognition": {"type": "And", "param": {
      "all_of": ["appraisal.page", "appraisal.page.close"], "box_index": 1
    }},
    "action": "Custom",
    "custom_action": "GuardedInput",
    "custom_action_param": {
      "task_id": "FREE_APPRAISAL_DAILY",
      "action_id": "close_appraisal_page",
      "kind": "click",
      "evidence": {
        "page_index": 0, "target_index": 1,
        "page_name": "appraisal.page", "target_name": "appraisal.page.close"
      }
    },
    "next": ["MJA_APPRAISAL_HOME_AFTER_SUCCESS"],
    "on_error": ["MJA_APPRAISAL_RECORD_FAILURE"],
    "timeout": 8000,
    "retry_times": 0
  },
  "MJA_APPRAISAL_HOME_AFTER_SUCCESS": {
    "recognition": {"type": "And", "param": {
      "all_of": ["appraisal.home.page", "appraisal.home.entry"], "box_index": 0
    }},
    "timeout": 8000,
    "action": "DoNothing",
    "next": ["MJA_HOME_BOUNDARY"],
    "on_error": ["MJA_APPRAISAL_RECORD_FAILURE"]
  },
  "MJA_APPRAISAL_HOME_AFTER_REWARD": {
    "recognition": {"type": "And", "param": {
      "all_of": ["appraisal.home.page", "appraisal.home.entry"], "box_index": 0
    }},
    "timeout": 8000,
    "action": "DoNothing",
    "next": ["MJA_HOME_BOUNDARY"],
    "on_error": ["MJA_APPRAISAL_RECORD_FAILURE"]
  },
  "MJA_APPRAISAL_SUCCESS_FROM_HOME": {
    "recognition": "DirectHit",
    "action": "Custom",
    "custom_action": "RecordTaskOutcome",
    "custom_action_param": {
      "task_id": "FREE_APPRAISAL_DAILY",
      "status": "success",
      "postcondition": "appraisal.reward_popup_seen"
    },
    "next": ["MJA_COMMON_STOP"]
  },
  "MJA_APPRAISAL_SUCCESS": {
    "recognition": "DirectHit",
    "action": "Custom",
    "custom_action": "RecordTaskOutcome",
    "custom_action_param": {
      "task_id": "FREE_APPRAISAL_DAILY",
      "status": "success",
      "postcondition": "appraisal.reward_popup_seen"
    },
    "next": ["MJA_COMMON_STOP"]
  },
  "MJA_APPRAISAL_RECORD_FAILURE": {
    "recognition": "DirectHit",
    "action": "Custom",
    "custom_action": "RecordTaskOutcome",
    "custom_action_param": {
      "task_id": "FREE_APPRAISAL_DAILY",
      "status": "failed",
      "postcondition": "APPRAISAL_POSTCONDITION_MISSING",
      "error_code": "APPRAISAL_POSTCONDITION_MISSING",
      "native_fail_after_record": true
    },
    "Abort": true,
    "next": ["MJA_COMMON_ABORT"]

  },
  "MJA_APPRAISAL_HOME_PROBE": {
    "recognition": {"type": "And", "param": {
      "all_of": ["appraisal.home.page", "appraisal.home.entry"],
      "box_index": 0
    }},
    "timeout": 8000,
    "action": "DoNothing",
    "next": ["MJA_APPRAISAL_OPEN_APPRAISAL"],
    "on_error": ["MJA_APPRAISAL_RECORD_FAILURE"]
  },
  "MJA_APPRAISAL_OPEN_APPRAISAL": {
    "max_hit": 1,
    "recognition": {"type": "And", "param": {
      "all_of": ["appraisal.home.page", "appraisal.home.entry"],
      "box_index": 1
    }},
    "action": "Custom",
    "custom_action": "GuardedInput",
    "custom_action_param": {
      "task_id": "FREE_APPRAISAL_DAILY",
      "action_id": "open_appraisal",
      "kind": "click",
      "evidence": {
        "page_index": 0, "target_index": 1,
        "page_name": "appraisal.home.page",
        "target_name": "appraisal.home.entry"
      }
    },
    "next": ["MJA_APPRAISAL_PAGE_PROBE"],
    "on_error": ["MJA_APPRAISAL_RECORD_FAILURE"],
    "retry_times": 0
  },
  "MJA_APPRAISAL_CLOSE_RECOVERED_PANEL": {
    "max_hit": 1,
    "recognition": {"type": "And", "param": {
      "all_of": ["appraisal.panel.page", "appraisal.panel.close"], "box_index": 1
    }},
    "timeout": 8000,
    "action": "Custom",
    "custom_action": "GuardedInput",
    "custom_action_param": {
      "task_id": "FREE_APPRAISAL_DAILY",
      "action_id": "close_function_panel",
      "kind": "click",
      "fixed_click_mode": "function_panel_close",
      "evidence": {
        "page_index": 0, "target_index": 1,
        "page_name": "appraisal.panel.page", "target_name": "appraisal.panel.close"
      }
    },
    "next": ["MJA_APPRAISAL_HOME_PROBE"],
    "on_error": ["MJA_APPRAISAL_RECORD_FAILURE"],
    "retry_times": 0
  },
  "MJA_APPRAISAL_EXTRA_POPUP_CLOSE": {
    "max_hit": 1,
    "recognition": {"type": "And", "param": {
      "all_of": [
        "appraisal.extra_popup.page",
        "appraisal.extra_popup.close"
      ],
      "box_index": 1
    }},
    "timeout": 8000,
    "action": "Custom",
    "custom_action": "GuardedInput",
    "custom_action_param": {
      "task_id": "FREE_APPRAISAL_DAILY",
      "action_id": "close_extra_reward_popup",
      "kind": "click",
      "evidence": {
        "page_index": 0,
        "target_index": 1,
        "page_name": "appraisal.extra_popup.page",
        "target_name": "appraisal.extra_popup.close"
      }
    },
    "retry_times": 0,
    "on_error": ["MJA_APPRAISAL_RECORD_FAILURE"]
  },
  "appraisal.home.page": {
    "recognition": "OCR",
    "expected": ["^战令$", "^活动$", "^祈福$", "^副本$", "^画卷$"],
    "roi": [800, 40, 370, 50],
    "action": "DoNothing"
  },
  "appraisal.home.entry": {
    "recognition": "OCR",
    "expected": ["^鉴宝$", "^宝$"],
    "roi": [925, 45, 65, 40],
    "action": "DoNothing"
  },
  "appraisal.page": {
    "recognition": "OCR",
    "expected": "^鉴宝$",
    "roi": [0, 0, 500, 220],
    "action": "DoNothing"
  },
  "appraisal.page.close": {
    "recognition": "TemplateMatch",
    "template": "daily/BUY_TEA_DAILY/shop_close.png",
    "roi": [1170, 0, 110, 110],
    "threshold": 0.39,
    "action": "DoNothing"
  },
  "appraisal.panel.page": {
    "recognition": "OCR",
    "expected": ["^活动$", "^商城$", "^日常$", "^武学研习$", "^秘宝$", "^帮会$", "^签到$"],
    "roi": [700, 180, 500, 420],
    "action": "DoNothing"
  },
  "appraisal.panel.close": {
    "recognition": {"type": "And", "param": {"all_of": ["MJA_GAME_SIDE_PANEL_OPEN"], "box_index": 0}},
    "action": "DoNothing"
  },
  "appraisal.universal_shop.page": {
    "recognition": "OCR",
    "expected": "^玉盟商会$",
    "roi": [0, 0, 280, 100],
    "action": "DoNothing"
  },
  "appraisal.universal_shop.close": {
    "recognition": "TemplateMatch",
    "template": "daily/BUY_TEA_DAILY/shop_close.png",
    "roi": [1160, 0, 100, 100],
    "threshold": 0.39,
    "action": "DoNothing"
  },
  "appraisal.free_once": {
    "recognition": "OCR",
    "expected": "^免费鉴宝$",
    "roi": [470, 590, 160, 60],
    "action": "DoNothing"
  },
  "appraisal.result_popup": {
    "recognition": "OCR",
    "expected": ["^鉴宝一次$", "^鉴宝十次$"],
    "roi": [350, 560, 600, 100],
    "action": "DoNothing"
  },
  "appraisal.result.banner": {
    "recognition": "OCR",
    "expected": "^传闻传[世也]高手.*已经出.*$",
    "roi": [650, 100, 590, 60],
    "action": "DoNothing"
  },
  "appraisal.extra_popup.page": {
    "recognition": "OCR",
    "expected": "^秘宝收集$",
    "roi": [500, 150, 330, 110],
    "action": "DoNothing"
  },
  "appraisal.extra_popup.close": {
    "recognition": "TemplateMatch",
    "template": "daily/BUY_TEA_DAILY/shop_close.png",
    "roi": [1160, 0, 100, 100],
    "threshold": 0.39,
    "action": "DoNothing"
  },
  "appraisal.popup_close": {
    "recognition": "ColorMatch",
    "lower": [150, 150, 130],
    "upper": [255, 255, 255],
    "roi": [1180, 10, 65, 65],
    "connected": true,
    "count": 250,
    "action": "DoNothing"
  }
}
