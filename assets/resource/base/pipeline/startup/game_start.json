{
  "启动-游戏入口": {
    "recognition": "DirectHit",
    "action": "StartApp",
    "package": "com.hanjiasongshu.dr22/.MainActivity",
    "max_hit": 1,
    "repeat": 5,
    "repeat_delay": 1000,
    "timeout": 1000,
    "next": ["启动-游戏启动"],
    "on_error": ["公共-通用-启动恢复-重启"]
  },
  "启动-游戏启动": {
    "recognition": "DirectHit",
    "action": "DoNothing",
    "timeout": 20000,
    "next": [
      "[JumpBack]启动-可选点击空白关闭",
      "[JumpBack]启动-可选关闭月签到奖励页",
      "启动-游戏就绪",
      "启动-游戏-按钮-之后-重启"
    ],
    "on_error": ["公共-通用-启动恢复-重启"]
  },
  "启动-游戏重启后": {
    "recognition": "DirectHit",
    "action": "DoNothing",
    "max_hit": 1,
    "timeout": 1000,
    "next": ["启动-游戏-按钮-之后-重启"],
    "on_error": ["公共-通用-启动恢复-耗尽"]
  },
  "启动-可选点击空白关闭": {
    "recognition": "OCR",
    "expected": [
      "点击空白处关闭",
      "点击任意空白区域关闭",
      "点击空白位置关闭"
    ],
    "roi": [350, 580, 600, 140],
    "timeout": 1500,
    "max_hit": 1,
    "action": "Click"
  },
  "启动-可选关闭月签到奖励页": {
    "recognition": "OCR",
    "expected": ["^本月可领取物品$", "^本月.*可领取.*物品$"],
    "roi": [150, 100, 900, 520],
    "timeout": 1500,
    "max_hit": 1,
    "action": "Click",
    "target": [1060, 152, 16, 16]
  },
  "启动-游戏就绪": {
    "recognition": "OCR",
    "expected": "已击破",
    "roi": [940, 660, 140, 40],
    "timeout": 10000,
    "action": "Custom",
    "custom_action": "RuntimeHealth"
  },
  "启动-游戏-按钮-之后-重启": {
    "recognition": "OCR",
    "expected": [
      "^开始游戏$",
      "^点击开始游戏$",
      "^点击开始游戏[！!]?$"
    ],
    "roi": [350, 540, 580, 170],
    "timeout": 10000,
    "max_hit": 1,
    "action": "Click",
    "next": ["启动-进入-游戏-按钮-之后-重启"],
    "on_error": ["公共-游戏启动开始按钮未找到"]
  },
  "启动-进入-游戏-按钮-之后-重启": {
    "recognition": "OCR",
    "expected": ["^进入游戏[！!]?$", "^点击进入游戏[！!]?$"],
    "roi": [350, 540, 580, 170],
    "timeout": 10000,
    "max_hit": 1,
    "action": "Click",
    "next": ["启动-进入游戏后等待"],
    "on_error": ["公共-游戏启动进入按钮未找到"]
  },
  "启动-进入游戏后等待": {
    "recognition": "DirectHit",
    "action": "DoNothing",
    "max_hit": 1,
    "timeout": 30000,
    "next": [
      "[JumpBack]启动-可选点击空白关闭",
      "[JumpBack]启动-可选关闭月签到奖励页",
      "启动-游戏就绪"
    ],
    "on_error": ["公共-游戏启动主页未到达"]
  }
}
