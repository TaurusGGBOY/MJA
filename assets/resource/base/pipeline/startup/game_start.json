{
  "启动-游戏入口": {
    "recognition": "DirectHit",
    "action": "DoNothing",
    "max_hit": 1,
    "timeout": 1000,
    "next": ["启动-游戏启动"]
  },
  "启动-游戏启动": {
    "recognition": "DirectHit",
    "action": "StartApp",
    "package": "com.hanjiasongshu.dr22/.MainActivity",
    "repeat": 5,
    "repeat_delay": 1000,
    "timeout": 20000,
    "post_delay": 5000,
    "next": [
      "[JumpBack]启动-可选关闭公告页",
      "启动-游戏启动成功-左下12探测"
    ],
    "on_error": ["公共-游戏启动失败"]
  },
  "启动-游戏启动成功-左下12探测": {
    "recognition": "OCR",
    "expected": "^12\\+?$",
    "roi": [0, 560, 540, 160],
    "timeout": 200000,
    "max_hit": 1,
    "action": "DoNothing",
    "next": [
      "[JumpBack]启动-数据校验失败-继续下载",
      "[JumpBack]启动-可选关闭月签到奖励页",
      "[JumpBack]启动-游戏启动后-进入按钮",
      "启动-游戏就绪"
    ],
    "on_error": ["公共-游戏启动失败"]
  },
  "启动-可选关闭公告页": {
    "recognition": "OCR",
    "expected": "公告|公|告",
    "roi": [0, 0, 420, 520],
    "timeout": 1500,
    "max_hit": 1,
    "action": "Click",
    "target": [1160, 0, 120, 100],
    "post_delay": 1000
  },
  "启动-数据校验失败-继续下载": {
    "recognition": "OCR",
    "expected": "数据校验失败",
    "roi": [250, 150, 800, 430],
    "timeout": 3000,
    "max_hit": 1,
    "action": "Click",
    "target": [650, 450, 300, 80],
    "post_delay": 1000
  },
  "启动-可选关闭月签到奖励页": {
    "recognition": "OCR",
    "expected": ["^本月可领取物品$", "^本月.*可领取.*物品$"],
    "roi": [150, 100, 900, 520],
    "timeout": 1500,
    "max_hit": 1,
    "action": "Click",
    "target": [1060, 152, 16, 16]
  },
  "启动-游戏就绪": {
    "recognition": {
      "type": "And",
      "param": {
        "all_of": [
          "公共-游戏主页-页面"
        ],
        "box_index": 0
      }
    },
    "timeout": 10000,
    "action": "Custom",
    "custom_action": "RuntimeHealth",
    "next": ["公共-主页边界"]
  },
  "启动-游戏启动后-进入按钮": {
    "recognition": "OCR",
    "expected": [
      "开始游戏",
      "点击开始游戏[！!]?",
      "点击开始游戏",
      "进入游戏[！!]?",
      "点击进入游戏[！!]?",
      "点击开始游戏[！!]?",
      "进入游戏[！!?]?",
      "点击进入游戏[！!?]?",
      "戏"
    ],
    "roi": [350, 540, 580, 170],
    "timeout": 15000,
    "max_hit": 5,
    "action": "Click",
    "target": [430, 600, 420, 100],
    "post_delay": 5000
  }
}
