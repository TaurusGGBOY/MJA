{
  "公共-主页边界": {
    "recognition": {
      "type": "And",
      "param": {
        "all_of": ["公共-游戏主页-页面"],
        "box_index": 0
      }
    },
    "timeout": 5000,
    "max_hit": 1,
    "action": "Custom",
    "custom_action": "CompleteTaskBoundary",
    "custom_action_param": {
      "boundary": "home"
    },
    "next": ["公共-通用停止"],
    "on_error": ["公共-主页边界-尝试返回"]
  },
  "公共-主页边界-尝试返回": {
    "recognition": "DirectHit",
    "timeout": 30000,
    "max_hit": 1,
    "action": "Custom",
    "custom_action": "ReturnToWorldHome",
    "next": ["公共-主页边界"],
    "on_error": ["公共-主页边界-失败"]
  },
  "公共-主页边界-失败": {
    "recognition": "DirectHit",
    "timeout": 1000,
    "max_hit": 1,
    "action": "Custom",
    "custom_action": "RecordActiveTaskFailure",
    "custom_action_param": {
      "postcondition": "home.boundary",
      "error_code": "HOME_BOUNDARY_COMPLETION_FAILED",
      "stop_game_on_failure": true,
      "native_fail_after_record": true
    },
    "status": "failed",
    "Abort": true,
    "next": ["公共-通用中止"]
  }
}
