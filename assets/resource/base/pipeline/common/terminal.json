  "公共-通用-启动恢复-耗尽": {
    "recognition": "DirectHit",
    "action": "Custom",
    "custom_action": "FailStartupRecovery",
    "custom_action_param": {
      "error_code": "GAME_START_RECOVERY_EXHAUSTED",
      "postcondition": "startup.game_ready"
