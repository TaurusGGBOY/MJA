{
  "公共-通用停止": {
    "recognition": "DirectHit",
    "action": "StopTask"
  },
  "公共-通用中止": {
    "recognition": "DirectHit",
    "action": "DoNothing",
    "timeout": 10000,
    "max_hit": 1,
    "next": ["公共-失败-主页-探测"],
    "on_error": ["公共-失败-返回主页"]
  },
  "公共-失败-主页-探测": {
    "recognition": {
      "type": "And",
      "param": {
        "all_of": ["公共-游戏主页-页面"],
        "box_index": 0
      }
    },
    "timeout": 5000,
    "max_hit": 1,
    "action": "DoNothing",
    "next": ["公共-主页边界"],
    "on_error": ["公共-失败-返回主页"]
  },
  "公共-失败-返回主页": {
    "recognition": "DirectHit",
    "timeout": 10000,
    "max_hit": 1,
    "action": "Custom",
    "custom_action": "ReturnToWorldHome",
    "next": ["公共-失败-主页-探测"],
    "on_error": ["公共-主页边界-失败"]
  },
  "公共-游戏启动失败": {
    "recognition": "DirectHit",
    "action": "Custom",
    "custom_action": "FailStartupRecovery",
    "custom_action_param": {
      "error_code": "GAME_START_APP_START_FAILED",
      "postcondition": "startup.app_started",
      "stage": "start_app",
      "expected": "APP 启动动作完成",
      "observed": "RestartGameSurface 返回失败",
      "root_cause": "APP 启动动作未完成"
    },
    "Abort": true,
    "timeout": 1000,
    "max_hit": 1
  },
  "公共-游戏启动开始按钮未找到": {
    "recognition": "DirectHit",
    "action": "Custom",
    "custom_action": "FailStartupRecovery",
    "custom_action_param": {
      "error_code": "GAME_START_START_BUTTON_NOT_FOUND",
      "postcondition": "startup.start_game_button_visible",
      "stage": "after_five_start_attempts",
      "expected": "OCR 识别到 开始游戏",
      "observed": "连续 5 次启动并分别等待 20 秒后仍未找到开始游戏按钮",
      "root_cause": "游戏进程可能在启动阶段退出，或前台停留在非开始页；5 次重启均未使开始游戏按钮进入 OCR ROI"
    },
    "Abort": true,
    "timeout": 1000,
    "max_hit": 1
  },
  "公共-游戏启动进入按钮未找到": {
    "recognition": "DirectHit",
    "action": "Custom",
    "custom_action": "FailStartupRecovery",
    "custom_action_param": {
      "error_code": "GAME_START_ENTER_BUTTON_NOT_FOUND",
      "postcondition": "startup.enter_game_button_visible",
      "stage": "after_click_start_game_5s",
      "expected": "OCR 识别到 进入游戏",
      "observed": "点击开始游戏并等待 5 秒后未找到进入游戏按钮",
      "root_cause": "开始游戏点击未生效，或二次进入页文字与 OCR 契约不一致"
    },
    "Abort": true,
    "timeout": 1000,
    "max_hit": 1
  },
  "公共-游戏启动主页未到达": {
    "recognition": "DirectHit",
    "action": "Custom",
