+    }
+
+    ~ScopedResource()
+    {
+        if (resource_) {
+            Release(resource_);
+        }
+    }
+
+    ScopedResource(const ScopedResource&) = delete;
+    ScopedResource& operator=(const ScopedResource&) = delete;
+
+    T get() const { return resource_; }
+    explicit operator bool() const { return resource_ != nullptr; }
