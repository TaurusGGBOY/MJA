+std::optional<cv::Mat> ScreenCaptureKitScreencap::screencap_window_core_graphics(uint32_t wid)
+{
+    auto logical_bounds = validate_window(wid);
+    if (!logical_bounds) {
+        return std::nullopt;
+    }
+
+    const CGRect bounds = CGRectMake(
+        logical_bounds->x,
+        logical_bounds->y,
+        logical_bounds->width,
+        logical_bounds->height);
+    const long rounded_width = std::lround(logical_bounds->width);
+    const long rounded_height = std::lround(logical_bounds->height);
+    if (rounded_width <= 0 || rounded_height <= 0 || rounded_width > std::numeric_limits<int>::max()
+        || rounded_height > std::numeric_limits<int>::max()) {
+        LogError << "MJA CoreGraphicsRegion rejected invalid rounded dimensions";
+        return std::nullopt;
+    }
+
+    ScopedResource<CGImageRef, CGImageRelease> image(CGWindowListCreateImage(
+        bounds,
+        kCGWindowListOptionOnScreenOnly,
+        kCGNullWindowID,
+        kCGWindowImageBoundsIgnoreFraming | kCGWindowImageNominalResolution));
+    if (!image) {
+        LogError << "MJA CoreGraphicsRegion capture failed; check Screen Recording permission";
+        return std::nullopt;
+    }
+
+    const size_t expected_width = static_cast<size_t>(rounded_width);
+    const size_t expected_height = static_cast<size_t>(rounded_height);
+    const size_t image_width = CGImageGetWidth(image.get());
+    const size_t image_height = CGImageGetHeight(image.get());
+    if (image_width == 0 || image_height == 0 || image_width != expected_width || image_height != expected_height) {
+        LogError << "MJA CoreGraphicsRegion returned non-nominal image dimensions";
+        return std::nullopt;
+    }
+
+    if (expected_width > std::numeric_limits<size_t>::max() / 4) {
+        LogError << "MJA CoreGraphicsRegion row stride overflow";
+        return std::nullopt;
+    }
+    const size_t bytes_per_row = expected_width * 4;
+    if (expected_height > std::numeric_limits<size_t>::max() / bytes_per_row) {
+        LogError << "MJA CoreGraphicsRegion image buffer overflow";
+        return std::nullopt;
+    }
+
+    std::vector<std::uint8_t> bgra(bytes_per_row * expected_height, 0);
+    ScopedResource<CGColorSpaceRef, CGColorSpaceRelease> color_space(CGColorSpaceCreateDeviceRGB());
+    if (!color_space) {
+        LogError << "MJA CoreGraphicsRegion failed to create device RGB color space";
+        return std::nullopt;
+    }
+
+    const CGBitmapInfo bitmap_info = static_cast<CGBitmapInfo>(
+        static_cast<std::uint32_t>(kCGBitmapByteOrder32Little)
+        | static_cast<std::uint32_t>(kCGImageAlphaPremultipliedFirst));
+    ScopedResource<CGContextRef, CGContextRelease> context(CGBitmapContextCreate(
+        bgra.data(),
+        expected_width,
+        expected_height,
+        8,
+        bytes_per_row,
+        color_space.get(),
+        bitmap_info));
+    if (!context) {
+        LogError << "MJA CoreGraphicsRegion failed to create bitmap context";
+        return std::nullopt;
+    }
+
+    const size_t actual_bytes_per_row = CGBitmapContextGetBytesPerRow(context.get());
+    if (actual_bytes_per_row != bytes_per_row) {
+        LogError << "MJA CoreGraphicsRegion bitmap context changed the row stride";
+        return std::nullopt;
+    }
+
+    CGContextSetBlendMode(context.get(), kCGBlendModeCopy);
+    CGContextSetInterpolationQuality(context.get(), kCGInterpolationNone);
+    CGContextTranslateCTM(context.get(), 0.0, static_cast<CGFloat>(expected_height));
+    CGContextScaleCTM(context.get(), 1.0, -1.0);
+    CGContextDrawImage(
+        context.get(),
+        CGRectMake(0.0, 0.0, static_cast<CGFloat>(expected_width), static_cast<CGFloat>(expected_height)),
+        image.get());
+    CGContextFlush(context.get());
+
+    cv::Mat owned_bgr;
+    try {
+        cv::Mat bgra_view(
+            static_cast<int>(expected_height),
+            static_cast<int>(expected_width),
+            CV_8UC4,
+            bgra.data(),
+            actual_bytes_per_row);
+        cv::cvtColor(bgra_view, owned_bgr, cv::COLOR_BGRA2BGR);
+    }
+    catch (const cv::Exception& error) {
+        LogError << "MJA CoreGraphicsRegion BGRA to BGR conversion failed:" << error.what();
+        return std::nullopt;
+    }
+
+    if (owned_bgr.empty() || owned_bgr.cols != rounded_width || owned_bgr.rows != rounded_height) {
+        LogError << "MJA CoreGraphicsRegion produced an invalid BGR image";
+        return std::nullopt;
+    }
+    return owned_bgr;
+}
