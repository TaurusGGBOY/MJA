+
+bool read_number(CFDictionaryRef dictionary, CFStringRef key, CFNumberType type, void* output)
+{
+    if (!dictionary || !output) {
+        return false;
+    }
+
+    CFTypeRef value = CFDictionaryGetValue(dictionary, key);
+    if (!value || CFGetTypeID(value) != CFNumberGetTypeID()) {
+        return false;
+    }
+    return CFNumberGetValue(static_cast<CFNumberRef>(value), type, output);
+}
+
+bool read_bool(CFDictionaryRef dictionary, CFStringRef key, bool& output)
+{
+    if (!dictionary) {
+        return false;
+    }
+
+    CFTypeRef value = CFDictionaryGetValue(dictionary, key);
+    if (!value || CFGetTypeID(value) != CFBooleanGetTypeID()) {
+        return false;
+    }
+    output = CFBooleanGetValue(static_cast<CFBooleanRef>(value));
+    return true;
+}
+
+bool read_bounds(CFDictionaryRef dictionary, CGRect& output)
+{
+    if (!dictionary) {
+        return false;
+    }
+
+    CFTypeRef value = CFDictionaryGetValue(dictionary, kCGWindowBounds);
+    if (!value || CFGetTypeID(value) != CFDictionaryGetTypeID()) {
+        return false;
+    }
+    return CGRectMakeWithDictionaryRepresentation(static_cast<CFDictionaryRef>(value), &output);
+}
+
+const char* read_utf8(CFDictionaryRef dictionary, CFStringRef key)
+{
+    if (!dictionary) {
+        return "";
+    }
+
+    CFTypeRef value = CFDictionaryGetValue(dictionary, key);
+    if (!value || CFGetTypeID(value) != CFStringGetTypeID()) {
+        return "";
+    }
+
+    NSString* string = (__bridge NSString*)value;
+    return string.UTF8String ? string.UTF8String : "";
+}
+
+bool usable_window(CFDictionaryRef dictionary, std::int64_t& window_id, CGRect& bounds)
+{
+    std::int64_t layer = -1;
+    std::int64_t owner_pid = -1;
+    double alpha = 0.0;
+    bool is_onscreen = false;
+    const bool has_onscreen_state = read_bool(dictionary, kCGWindowIsOnscreen, is_onscreen);
+    if (!read_number(dictionary, kCGWindowNumber, kCFNumberSInt64Type, &window_id)
+        || !read_number(dictionary, kCGWindowLayer, kCFNumberSInt64Type, &layer)
+        || !read_number(dictionary, kCGWindowOwnerPID, kCFNumberSInt64Type, &owner_pid)
+        || !read_number(dictionary, kCGWindowAlpha, kCFNumberDoubleType, &alpha)
+        || !read_bounds(dictionary, bounds)) {
+        return false;
+    }
+
+    return layer == 0 && owner_pid > 0 && (!has_onscreen_state || is_onscreen)
+           && std::isfinite(alpha) && alpha > 0.0
+           && !CGRectIsNull(bounds) && !CGRectIsInfinite(bounds) && std::isfinite(bounds.size.width)
+           && std::isfinite(bounds.size.height) && bounds.size.width >= 640.0
+           && bounds.size.width <= 4096.0 && bounds.size.height >= 360.0
+           && bounds.size.height <= 2160.0 && bounds.size.width > bounds.size.height;
+}
+
